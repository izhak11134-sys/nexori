// Generated by scripts/build-firestore-rules.mjs from the approved card schema.
// Auth + Firestore only. No Functions, Storage or billing activation.
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function owner() {
      return request.auth != null && request.auth.token.email_verified == true
        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.active == true;
    }
    function uuid(id) { return id is string && id.matches('[a-f0-9-]{36}'); }
    function patch_products(p, published, pattern) {
      return p is map && p.keys().hasOnly(published ? ["name","description","type","tipsText","image","imageAlt","category","typeId"] : ["name","description","type","tipsText","image","imageAlt","category","typeId","retailerUrl","editorNotes"])
        && p.get("image", '').matches(pattern);
    }
    function patch_categories(p, published, pattern) {
      return p is map && p.keys().hasOnly(["label","short","description","image","imageAlt"])
        && p.get("image", '').matches(pattern);
    }
    function patch_types(p, published, pattern) {
      return p is map && p.keys().hasOnly(["name","examples","image","imageAlt"])
        && p.get("image", '').matches(pattern);
    }
    function patch_worlds(p, published, pattern) {
      return p is map && p.keys().hasOnly(["cardTitle","subtitle","cardImage","pageTitle","pageDescription","pageImage","imageAlt"])
        && p.get("cardImage", '').matches(pattern)
        && p.get("pageImage", '').matches(pattern);
    }
    function patch_guides(p, published, pattern) {
      return p is map && p.keys().hasOnly(["title","description","eyebrow","time","image","imageAlt"])
        && p.get("image", '').matches(pattern);
    }
    function patch_blocks(p, published, pattern) {
      return p is map && p.keys().hasOnly(["title","lead","accent","ending","description","image","imageAlt"])
        && p.get("image", '').matches(pattern);
    }
    function patch_pages(p, published, pattern) {
      return p is map && p.keys().hasOnly(["title","description","image","imageAlt"])
        && p.get("image", '').matches(pattern);
    }
    function chunk_products_0(r, published, pattern) {
      return r is map && r.keys().hasOnly(["midnight-ronin","off-duty-hoodie","after-hours-desk","moonlight-blade","mecha-unit","city-after-dark"])
        && (!("midnight-ronin" in r) || patch_products(r["midnight-ronin"], published, pattern))
        && (!("off-duty-hoodie" in r) || patch_products(r["off-duty-hoodie"], published, pattern))
        && (!("after-hours-desk" in r) || patch_products(r["after-hours-desk"], published, pattern))
        && (!("moonlight-blade" in r) || patch_products(r["moonlight-blade"], published, pattern))
        && (!("mecha-unit" in r) || patch_products(r["mecha-unit"], published, pattern))
        && (!("city-after-dark" in r) || patch_products(r["city-after-dark"], published, pattern));
    }
    function chunk_categories_0(r, published, pattern) {
      return r is map && r.keys().hasOnly(["figures","style","desk","props","accessories"])
        && (!("figures" in r) || patch_categories(r["figures"], published, pattern))
        && (!("style" in r) || patch_categories(r["style"], published, pattern))
        && (!("desk" in r) || patch_categories(r["desk"], published, pattern))
        && (!("props" in r) || patch_categories(r["props"], published, pattern))
        && (!("accessories" in r) || patch_categories(r["accessories"], published, pattern));
    }
    function chunk_types_0(r, published, pattern) {
      return r is map && r.keys().hasOnly(["display-figures","articulated-figures","model-kits","t-shirts","hoodies","jackets","hats","desk-mats","art-prints","room-decor","decorative-replicas","costume-props","keychains","bags","pins","jewellery"])
        && (!("display-figures" in r) || patch_types(r["display-figures"], published, pattern))
        && (!("articulated-figures" in r) || patch_types(r["articulated-figures"], published, pattern))
        && (!("model-kits" in r) || patch_types(r["model-kits"], published, pattern))
        && (!("t-shirts" in r) || patch_types(r["t-shirts"], published, pattern))
        && (!("hoodies" in r) || patch_types(r["hoodies"], published, pattern))
        && (!("jackets" in r) || patch_types(r["jackets"], published, pattern))
        && (!("hats" in r) || patch_types(r["hats"], published, pattern))
        && (!("desk-mats" in r) || patch_types(r["desk-mats"], published, pattern))
        && (!("art-prints" in r) || patch_types(r["art-prints"], published, pattern))
        && (!("room-decor" in r) || patch_types(r["room-decor"], published, pattern))
        && (!("decorative-replicas" in r) || patch_types(r["decorative-replicas"], published, pattern))
        && (!("costume-props" in r) || patch_types(r["costume-props"], published, pattern))
        && (!("keychains" in r) || patch_types(r["keychains"], published, pattern))
        && (!("bags" in r) || patch_types(r["bags"], published, pattern))
        && (!("pins" in r) || patch_types(r["pins"], published, pattern))
        && (!("jewellery" in r) || patch_types(r["jewellery"], published, pattern));
    }
    function chunk_worlds_0(r, published, pattern) {
      return r is map && r.keys().hasOnly(["one-piece","naruto","demon-slayer","jujutsu-kaisen","dragon-ball","attack-on-titan"])
        && (!("one-piece" in r) || patch_worlds(r["one-piece"], published, pattern))
        && (!("naruto" in r) || patch_worlds(r["naruto"], published, pattern))
        && (!("demon-slayer" in r) || patch_worlds(r["demon-slayer"], published, pattern))
        && (!("jujutsu-kaisen" in r) || patch_worlds(r["jujutsu-kaisen"], published, pattern))
        && (!("dragon-ball" in r) || patch_worlds(r["dragon-ball"], published, pattern))
        && (!("attack-on-titan" in r) || patch_worlds(r["attack-on-titan"], published, pattern));
    }
    function chunk_guides_0(r, published, pattern) {
      return r is map && r.keys().hasOnly(["first-figure","anime-space","buying-safely"])
        && (!("first-figure" in r) || patch_guides(r["first-figure"], published, pattern))
        && (!("anime-space" in r) || patch_guides(r["anime-space"], published, pattern))
        && (!("buying-safely" in r) || patch_guides(r["buying-safely"], published, pattern));
    }
    function chunk_blocks_0(r, published, pattern) {
      return r is map && r.keys().hasOnly(["hero","editorial","afterhours","closing"])
        && (!("hero" in r) || patch_blocks(r["hero"], published, pattern))
        && (!("editorial" in r) || patch_blocks(r["editorial"], published, pattern))
        && (!("afterhours" in r) || patch_blocks(r["afterhours"], published, pattern))
        && (!("closing" in r) || patch_blocks(r["closing"], published, pattern));
    }
    function chunk_pages_0(r, published, pattern) {
      return r is map && r.keys().hasOnly(["about-story","about-research","about-explain","about-links","about-honesty","disclosure-0","disclosure-1","disclosure-2","disclosure-3","disclosure-4","disclosure-5","privacy-0","privacy-1","privacy-2","privacy-3","privacy-4","privacy-5","privacy-6","privacy-7","privacy-8","terms-0","terms-1","terms-2","terms-3","terms-4","terms-5","terms-6","terms-7","contact-0","contact-1","contact-2","contact-3","accessibility-0","accessibility-1","accessibility-2","accessibility-3","accessibility-4","rights-0","rights-1","rights-2","rights-3"])
        && (!("about-story" in r) || patch_pages(r["about-story"], published, pattern))
        && (!("about-research" in r) || patch_pages(r["about-research"], published, pattern))
        && (!("about-explain" in r) || patch_pages(r["about-explain"], published, pattern))
        && (!("about-links" in r) || patch_pages(r["about-links"], published, pattern))
        && (!("about-honesty" in r) || patch_pages(r["about-honesty"], published, pattern))
        && (!("disclosure-0" in r) || patch_pages(r["disclosure-0"], published, pattern))
        && (!("disclosure-1" in r) || patch_pages(r["disclosure-1"], published, pattern))
        && (!("disclosure-2" in r) || patch_pages(r["disclosure-2"], published, pattern))
        && (!("disclosure-3" in r) || patch_pages(r["disclosure-3"], published, pattern))
        && (!("disclosure-4" in r) || patch_pages(r["disclosure-4"], published, pattern))
        && (!("disclosure-5" in r) || patch_pages(r["disclosure-5"], published, pattern))
        && (!("privacy-0" in r) || patch_pages(r["privacy-0"], published, pattern))
        && (!("privacy-1" in r) || patch_pages(r["privacy-1"], published, pattern))
        && (!("privacy-2" in r) || patch_pages(r["privacy-2"], published, pattern))
        && (!("privacy-3" in r) || patch_pages(r["privacy-3"], published, pattern))
        && (!("privacy-4" in r) || patch_pages(r["privacy-4"], published, pattern))
        && (!("privacy-5" in r) || patch_pages(r["privacy-5"], published, pattern))
        && (!("privacy-6" in r) || patch_pages(r["privacy-6"], published, pattern))
        && (!("privacy-7" in r) || patch_pages(r["privacy-7"], published, pattern))
        && (!("privacy-8" in r) || patch_pages(r["privacy-8"], published, pattern))
        && (!("terms-0" in r) || patch_pages(r["terms-0"], published, pattern));
    }
    function chunk_pages_1(r, published, pattern) {
      return r is map && r.keys().hasOnly(["about-story","about-research","about-explain","about-links","about-honesty","disclosure-0","disclosure-1","disclosure-2","disclosure-3","disclosure-4","disclosure-5","privacy-0","privacy-1","privacy-2","privacy-3","privacy-4","privacy-5","privacy-6","privacy-7","privacy-8","terms-0","terms-1","terms-2","terms-3","terms-4","terms-5","terms-6","terms-7","contact-0","contact-1","contact-2","contact-3","accessibility-0","accessibility-1","accessibility-2","accessibility-3","accessibility-4","rights-0","rights-1","rights-2","rights-3"])
        && (!("terms-1" in r) || patch_pages(r["terms-1"], published, pattern))
        && (!("terms-2" in r) || patch_pages(r["terms-2"], published, pattern))
        && (!("terms-3" in r) || patch_pages(r["terms-3"], published, pattern))
        && (!("terms-4" in r) || patch_pages(r["terms-4"], published, pattern))
        && (!("terms-5" in r) || patch_pages(r["terms-5"], published, pattern))
        && (!("terms-6" in r) || patch_pages(r["terms-6"], published, pattern))
        && (!("terms-7" in r) || patch_pages(r["terms-7"], published, pattern))
        && (!("contact-0" in r) || patch_pages(r["contact-0"], published, pattern))
        && (!("contact-1" in r) || patch_pages(r["contact-1"], published, pattern))
        && (!("contact-2" in r) || patch_pages(r["contact-2"], published, pattern))
        && (!("contact-3" in r) || patch_pages(r["contact-3"], published, pattern))
        && (!("accessibility-0" in r) || patch_pages(r["accessibility-0"], published, pattern))
        && (!("accessibility-1" in r) || patch_pages(r["accessibility-1"], published, pattern))
        && (!("accessibility-2" in r) || patch_pages(r["accessibility-2"], published, pattern))
        && (!("accessibility-3" in r) || patch_pages(r["accessibility-3"], published, pattern))
        && (!("accessibility-4" in r) || patch_pages(r["accessibility-4"], published, pattern))
        && (!("rights-0" in r) || patch_pages(r["rights-0"], published, pattern))
        && (!("rights-1" in r) || patch_pages(r["rights-1"], published, pattern))
        && (!("rights-2" in r) || patch_pages(r["rights-2"], published, pattern))
        && (!("rights-3" in r) || patch_pages(r["rights-3"], published, pattern));
    }
    function payloadHeader(p) {
      return p is map && p.keys().hasOnly(['version', 'changes']) && p.version == 1
        && p.changes is map && p.changes.keys().hasOnly(["products","categories","types","worlds","guides","blocks","pages"]);
    }
    function groupData(group, records, published) {
      let pattern = published ? '(|spark:published/[a-f0-9-]{36}/[a-f0-9-]{36})'
        : '(|spark:published/[a-f0-9-]{36}/[a-f0-9-]{36}|spark:drafts/' + request.auth.uid + '/[a-f0-9-]{36})';
      return (group == "products-0" && chunk_products_0(records, published, pattern))
        || (group == "categories-0" && chunk_categories_0(records, published, pattern))
        || (group == "types-0" && chunk_types_0(records, published, pattern))
        || (group == "worlds-0" && chunk_worlds_0(records, published, pattern))
        || (group == "guides-0" && chunk_guides_0(records, published, pattern))
        || (group == "blocks-0" && chunk_blocks_0(records, published, pattern))
        || (group == "pages-0" && chunk_pages_0(records, published, pattern))
        || (group == "pages-1" && chunk_pages_1(records, published, pattern));
    }
    function draftEnvelope() {
      let d = request.resource.data;
      return d.keys().hasOnly(['payload', 'revision', 'draftId', 'updatedAt', 'updatedBy'])
        && d.revision is int && d.updatedBy == request.auth.uid && d.updatedAt == request.time
        && uuid(d.draftId) && payloadHeader(d.payload)
        && get(/databases/$(database)/documents/draftContent/$(request.auth.uid)/versions/$(d.draftId)/groups/products-0).data.records == d.payload.changes.get("products", {})
        && get(/databases/$(database)/documents/draftContent/$(request.auth.uid)/versions/$(d.draftId)/groups/categories-0).data.records == d.payload.changes.get("categories", {})
        && get(/databases/$(database)/documents/draftContent/$(request.auth.uid)/versions/$(d.draftId)/groups/types-0).data.records == d.payload.changes.get("types", {})
        && get(/databases/$(database)/documents/draftContent/$(request.auth.uid)/versions/$(d.draftId)/groups/worlds-0).data.records == d.payload.changes.get("worlds", {})
        && get(/databases/$(database)/documents/draftContent/$(request.auth.uid)/versions/$(d.draftId)/groups/guides-0).data.records == d.payload.changes.get("guides", {})
        && get(/databases/$(database)/documents/draftContent/$(request.auth.uid)/versions/$(d.draftId)/groups/blocks-0).data.records == d.payload.changes.get("blocks", {})
        && get(/databases/$(database)/documents/draftContent/$(request.auth.uid)/versions/$(d.draftId)/groups/pages-0).data.records == d.payload.changes.get("pages", {})
        && get(/databases/$(database)/documents/draftContent/$(request.auth.uid)/versions/$(d.draftId)/groups/pages-1).data.records == d.payload.changes.get("pages", {});
    }
    function publicEnvelope() {
      let d = request.resource.data;
      let release = getAfter(/databases/$(database)/documents/mediaReleases/$(d.revisionId)).data;
      return d.keys().hasOnly(['payload', 'revision', 'revisionId', 'updatedAt'])
        && d.revision is int && uuid(d.revisionId) && d.updatedAt == request.time
        && payloadHeader(d.payload) && release.revision == d.revision
        && get(/databases/$(database)/documents/publishedContent/$(d.revisionId)/groups/products-0).data.records == d.payload.changes.get("products", {})
        && get(/databases/$(database)/documents/publishedContent/$(d.revisionId)/groups/categories-0).data.records == d.payload.changes.get("categories", {})
        && get(/databases/$(database)/documents/publishedContent/$(d.revisionId)/groups/types-0).data.records == d.payload.changes.get("types", {})
        && get(/databases/$(database)/documents/publishedContent/$(d.revisionId)/groups/worlds-0).data.records == d.payload.changes.get("worlds", {})
        && get(/databases/$(database)/documents/publishedContent/$(d.revisionId)/groups/guides-0).data.records == d.payload.changes.get("guides", {})
        && get(/databases/$(database)/documents/publishedContent/$(d.revisionId)/groups/blocks-0).data.records == d.payload.changes.get("blocks", {})
        && get(/databases/$(database)/documents/publishedContent/$(d.revisionId)/groups/pages-0).data.records == d.payload.changes.get("pages", {})
        && get(/databases/$(database)/documents/publishedContent/$(d.revisionId)/groups/pages-1).data.records == d.payload.changes.get("pages", {});
    }
    function imageData() {
      let d = request.resource.data;
      return d.bytes is bytes && d.bytes.size() > 0 && d.bytes.size() <= 196608
        && d.mime == 'image/webp' && d.createdAt == request.time;
    }
    match /admins/{uid} {
      allow get: if request.auth != null && request.auth.uid == uid;
      allow list, write: if false;
    }
    match /cms/draft {
      allow read: if owner();
      allow create: if owner() && draftEnvelope() && request.resource.data.revision == 1;
      allow update: if owner() && draftEnvelope() && request.resource.data.revision == resource.data.revision + 1;
      allow delete: if false;
    }
    match /draftContent/{uid}/versions/{version}/groups/{group} {
      allow read: if owner() && request.auth.uid == uid;
      allow create: if owner() && request.auth.uid == uid && uuid(version)
        && request.resource.data.keys().hasOnly(['records', 'createdAt'])
        && request.resource.data.createdAt == request.time
        && groupData(group, request.resource.data.records, false);
      allow update, delete: if false;
    }
    match /publishedContent/{release}/groups/{group} {
      allow read: if exists(/databases/$(database)/documents/mediaReleases/$(release));
      allow create: if owner() && uuid(release)
        && request.resource.data.keys().hasOnly(['records', 'createdAt'])
        && request.resource.data.createdAt == request.time
        && groupData(group, request.resource.data.records, true)
        && !exists(/databases/$(database)/documents/mediaReleases/$(release));
      allow update, delete: if false;
    }
    match /public/site {
      allow read: if true;
      allow create: if owner() && publicEnvelope() && request.resource.data.revision == 1;
      allow update: if owner() && publicEnvelope() && request.resource.data.revision == resource.data.revision + 1;
      allow delete: if false;
    }
    match /revisions/{id} {
      allow read: if owner();
      allow create: if owner()
        && request.resource.data.keys().hasOnly(['payload', 'revision', 'createdAt', 'kind'])
        && request.resource.data.createdAt == request.time
        && ((id == 'initial' && !exists(/databases/$(database)/documents/public/site)
          && getAfter(/databases/$(database)/documents/public/site).data.revision == 1
          && request.resource.data.revision == 0 && request.resource.data.kind == 'initial'
          && request.resource.data.payload == {'version': 1, 'changes': {}})
        || (uuid(id) && request.resource.data.kind in ['publish', 'restore']
          && getAfter(/databases/$(database)/documents/public/site).data.revisionId == id
          && getAfter(/databases/$(database)/documents/public/site).data.revision == request.resource.data.revision
          && getAfter(/databases/$(database)/documents/public/site).data.payload == request.resource.data.payload));
      allow update, delete: if false;
    }
    match /mediaReleases/{id} {
      allow read: if owner();
      allow create: if owner() && uuid(id)
        && request.resource.data.keys().hasOnly(['revision', 'createdAt'])
        && request.resource.data.createdAt == request.time
        && getAfter(/databases/$(database)/documents/public/site).data.revisionId == id
        && getAfter(/databases/$(database)/documents/public/site).data.revision == request.resource.data.revision
        && getAfter(/databases/$(database)/documents/revisions/$(id)).data.revision == request.resource.data.revision
        && getAfter(/databases/$(database)/documents/revisions/$(id)).data.payload == getAfter(/databases/$(database)/documents/public/site).data.payload;
      allow update, delete: if false;
    }
    match /draftImages/{uid}/images/{id} {
      allow read: if owner() && request.auth.uid == uid;
      allow create: if owner() && request.auth.uid == uid && uuid(id) && imageData()
        && request.resource.data.keys().hasOnly(['bytes', 'mime', 'createdAt']);
      allow update, delete: if false;
    }
    match /publishedImages/{release}/images/{id} {
      allow read: if exists(/databases/$(database)/documents/mediaReleases/$(release));
      allow create: if owner() && uuid(release) && uuid(id) && imageData()
        && request.resource.data.keys().hasOnly(['bytes', 'mime', 'sourceId', 'createdAt'])
        && uuid(request.resource.data.sourceId)
        && !exists(/databases/$(database)/documents/mediaReleases/$(release))
        && request.resource.data.bytes == get(/databases/$(database)/documents/draftImages/$(request.auth.uid)/images/$(request.resource.data.sourceId)).data.bytes;
      allow update, delete: if false;
    }
    match /{document=**} { allow read, write: if false; }
  }
}
