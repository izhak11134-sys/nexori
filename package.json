{
  "name": "nexori",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test:catalog": "node --test tests/catalog.test.js",
    "test:content": "node --test tests/content.test.js",
    "dev": "vite --host 0.0.0.0",
    "build": "vite build && npm run build:html",
    "build:html": "node scripts/build-standalone.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "firebase:sync": "node scripts/build-firestore-rules.mjs",
    "firebase:emulators": "npm run firebase:sync && firebase emulators:start --project demo-nexori --only auth,firestore",
    "test:firebase": "npm run firebase:sync && firebase emulators:exec --project demo-nexori --only auth,firestore \"node --test --test-concurrency=1 tests/firebase-spark.integration.test.js\"",
    "test:firebase-validation": "node --test tests/firebase-spark-validation.test.js"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "6.0.0",
    "firebase-tools": "15.33.0",
    "vite": "7.1.12"
  },
  "dependencies": {
    "firebase": "13.0.0"
  },
  "overrides": {
    "@grpc/grpc-js": "1.13.6"
  }
}
